  "diagnosis": [
    {
      "q": "Klamka zewnętrzna się unosi, ale drzwi się nie otwierają (zamek centralny działa)",
      "a": "To najczęstsza usterka E53: pęka lub wypada z położenia mechanizm klamki. Zanim kupisz część, zdejmij boczek i sprawdź, czy oś nie wysunęła się z gniazda.",
      "repair": {
        "przód": "klamka-zewn-przod",
        "tył": "klamka-zewn-tyl"
      }
    },
    {
      "q": "Klamka zewnętrzna wypada z gniazda lub ma luz z boku",
      "a": "Mogły się ukruszyć zaczepy w plastiku klamki. Takiej klamki nie da się naprawić, kupujesz nową (lub używaną w kolorze).",
      "repair": {
        "przód": "klamka-zewn-przod"
      }
    },
    {
      "q": "Zamek zamyka lub otwiera te drzwi wolno albo nie za pierwszym razem",
      "a": "Typowy objaw słabnącego siłownika zamka. Nie czekaj do całkowitej awarii: wg relacji z forum słaby siłownik potrafi uszkodzić plastikowe mocowanie linki.",
      "repair": {
        "przód": "silownik-zamka-przod"
      }
    },
    {
      "q": "Klamka wewnętrzna jest luźna, porysowana albo złamana",
      "a": "Znana słabość modelu. Dostępne są tańsze zamienniki, a przy samym zdartym wykończeniu można rozważyć nakładkę.",
      "repair": {
        "przód/tył": "klamka-wewn"
      }
    },
    {
      "q": "W drzwiach nie działa nic z elektryki (szyba, lusterko, zamek, światełko)",
      "a": "Zanim kupisz części, sprawdź wtyczkę wiązki między drzwiami a słupkiem (przy zawiasie) pod kątem korozji. To wspólny punkt zasilania całych drzwi (wskazówka z forum). Karta napraw: wkrótce."
    },
    {
      "q": "Drzwi tylne nie chcą się otworzyć z żadnej strony",
      "a": "Najpierw sprawdź blokadę dziecięcą na krawędzi drzwi. Przestawienie jej bywa pierwszym krokiem do awaryjnego otwarcia.",
      "repair": {
        "tył": "klamka-zewn-tyl"
      }
    }
  ],
